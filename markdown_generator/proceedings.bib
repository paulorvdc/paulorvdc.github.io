@inproceedings{carmo26frank,
author = {Viviurka Do Carmo, Paulo and Lopes, Alvaro Jos{\'e} and Silva G{\^o}lo, Marcos Paulo and Marx, Edgard},
title = {FranKGraphBench: Reproducible Benchmarking for Knowledge Graph-based Recommendation},
year = {2026},
isbn = {9798400725395},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799682.3840189},
doi = {10.1145/3799682.3840189},
abstract = {Knowledge Graphs (KGs) enable the integration of data across multiple domains and data types, supporting human interpretability, machine processing, and distributed data access. KGs have become especially valuable for enhancing recommender systems (RSs), which provide personalized user experiences and are now ubiquitous across platforms such as social media, streaming services, e-commerce, news, and search engines. However, reproducibility remains a persistent challenge in developing and evaluating machine learning methods for KG-based RSs, due to heterogeneous data sources and model complexity. Therefore, we introduce FranKGraphBench, a modular benchmarking framework that consolidates baseline models, datasets, and evaluation metrics into a standardized structure. Users can define experiments via configuration files, enabling reproducible sharing of model specifications, datasets, and evaluation settings. FranKGraphBench contains 6 KG-form RS datasets: 3 DBpedia-enriched, 1 Wikidata-enriched, and 2 unenriched. Finally, we validate its effectiveness through a small benchmark and an ablation study to showcase its capabilities and the importance of open settings for reproducible experimentation.},
booktitle = {Proceedings of the 35th ACM International Conference on Information and Knowledge Management},
pages = {9024–9029},
numpages = {6},
keywords = {knowledge graphs, recommender systems, reproducibility},
location = {Rome, Italy},
series = {CIKM '26}
}

